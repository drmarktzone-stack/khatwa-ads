# All optional. The app always completes a scan with the facts fallback.
# Owner-style aliases used on other GCP services are accepted.

# --- Project / region (Cloud Run + Vertex) ---
GOOGLE_CLOUD_PROJECT=
GCP_PROJECT=
VERTEX_PROJECT=
GOOGLE_CLOUD_LOCATION=me-west1
VERTEX_LOCATION=me-west1
GCP_LOCATION=me-west1

# --- Models ---
VERTEX_MODEL=gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash
VERTEX_IMAGE_MODEL=gemini-2.5-flash-image
IMAGEN_MODEL=imagen-3.0-generate-002
VERTEX_GROUNDING=1

# --- Keys (any one is enough; Cloud Run ADC works without these) ---
GEMINI_API_KEY=
GOOGLE_API_KEY=
VERTEX_API_KEY=
GOOGLE_AI_API_KEY=
GOOGLE_TRANSLATE_API_KEY=
TRANSLATE_API_KEY=

PORT=8080
