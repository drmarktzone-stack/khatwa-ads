# Optional. Khatwa Ads works offline with the facts-only copy engine.
# If set, Gemini is asked to rewrite lines using ONLY extracted facts.
# Never invents prices, phones, places, or ROAS.

# Google AI Studio key (simplest)
GEMINI_API_KEY=

# Or Vertex AI on Cloud Run (uses the service account + project)
GOOGLE_CLOUD_PROJECT=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.0-flash

PORT=8080
